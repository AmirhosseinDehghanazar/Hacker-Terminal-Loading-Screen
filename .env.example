# Copy this file to collector/.env for LOCAL runs only.
# In production, these are set as GitHub Actions secrets/variables — never commit
# a real .env file, and never put a token in this example file.

# A GitHub Personal Access Token (fine-grained) with:
#   - Contents: Read and write   (needed to read repo metadata & commit dataset updates locally)
#   - Administration: Read-only  (traffic endpoints require push access to the repo)
# Classic tokens work too: use the "repo" scope.
GH_ANALYTICS_TOKEN=

# owner/repo of the repository you're tracking, e.g. octocat/hello-world
GH_ANALYTICS_REPO=

# Optional: override where the dataset is written. Defaults to ../data/history.json
# HISTORY_PATH=../data/history.json
